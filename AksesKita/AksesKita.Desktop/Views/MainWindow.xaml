<Window x:Class="AksesKita.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AksesKita.Desktop.Views"
        xmlns:vm="clr-namespace:AksesKita.Desktop.ViewModels"
        Title="AksesKita — Ruang Inklusif" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportListViewModel}">
            <views:ReportListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateReportViewModel}">
            <views:CreateReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportDetailViewModel}">
            <views:ReportDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <views:MapView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ===== Login screen (shown before sign-in) ===== -->
        <ContentControl Content="{Binding LoginVM}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- ===== App shell (shown after sign-in) ===== -->
        <Grid x:Name="ShellRoot" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,20,16,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,24">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Teal}">
                            <TextBlock Text="&#9855;" FontSize="22" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AksesKita" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Ruang Inklusif" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Content="⎋  Keluar"
                            Command="{Binding LogoutCommand}" Margin="0,12,0,0"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="v2.4 • WCAG 2.1 AA Compliant"
                               FontSize="10.5" Foreground="#94A3B8" Margin="4,10,0,0"/>
                    <Border DockPanel.Dock="Bottom" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1"
                            CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Bantuan Akses" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Command Center Surabaya 112" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav: the same five pages for every role; actions inside each page depend on the role -->
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Style="{StaticResource NavItem}" Content="📊   Dashboard &amp; Analitik"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Dashboard, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="🗺   Peta Interaktif"
                                     Command="{Binding NavigateCommand}" CommandParameter="Map"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Map, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="📋   Daftar &amp; Manajemen Laporan"
                                     Command="{Binding NavigateCommand}" CommandParameter="ReportList"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=ReportList, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="➕   Formulir Laporan Baru"
                                     Command="{Binding NavigateCommand}" CommandParameter="CreateReport"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=CreateReport, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="📄   Detail Laporan"
                                     Command="{Binding NavigateCommand}" CommandParameter="ReportDetail"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=ReportDetail, Mode=OneWay}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Right side -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Global search: press Enter to jump to the report list -->
                        <Grid Grid.Column="0" MaxWidth="480" HorizontalAlignment="Left" Width="480">
                            <Border Background="#F1F5F9" CornerRadius="10"/>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="13"
                                     Padding="38,10,14,10" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="&#128269;" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Cari laporan, lokasi fasilitas, atau ID tiket... (Enter)" Margin="38,0,0,0"
                                       VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="Aa  Ukuran" Padding="12,7" Margin="0,0,16,0"
                                    Command="{Binding CycleScaleCommand}" ToolTip="Ubah ukuran teks &amp; tampilan"/>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Navy}" Margin="0,0,10,0">
                                <TextBlock Text="&#128100;" Foreground="White" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Session.UserName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="{Binding Session.RoleLabel}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
