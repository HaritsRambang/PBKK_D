<UserControl x:Class="AksesKita.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Background="#CFFAFE" CornerRadius="20" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="Dinas PU Bina Marga &amp; Dishub Kota Surabaya • Data Real-time"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#155E75"/>
                        </Border>
                        <TextBlock Text="{Binding Greeting}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                        <TextBlock Text="Pantau percepatan pemulihan aksesibilitas publik dan audit hambatan mobilitas ramah disabilitas di Surabaya."
                                   Style="{StaticResource CardSub}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Style="{StaticResource Chip}" Content="7 Hari" Command="{Binding SetPeriodCommand}" CommandParameter="7"
                                         IsChecked="{Binding PeriodKey, Converter={StaticResource PageToBool}, ConverterParameter=7, Mode=OneWay}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="30 Hari" Command="{Binding SetPeriodCommand}" CommandParameter="30"
                                         IsChecked="{Binding PeriodKey, Converter={StaticResource PageToBool}, ConverterParameter=30, Mode=OneWay}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Triwulan" Margin="0,0,0,8" Command="{Binding SetPeriodCommand}" CommandParameter="90"
                                         IsChecked="{Binding PeriodKey, Converter={StaticResource PageToBool}, ConverterParameter=90, Mode=OneWay}"/>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="⤓  Ekspor Rekap (CSV)" Command="{Binding ExportCsvCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metric cards -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL LAPORAN MASUK" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{Binding TotalReports, StringFormat={}{0:N0}}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding TotalDelta}" FontSize="11.5" Foreground="#16A34A" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="DALAM PENANGANAN" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{Binding InProgress}" FontSize="32" FontWeight="Bold" Foreground="#0E7490" Margin="0,8,0,4"/>
                        <TextBlock Text="terverifikasi &amp; sedang diperbaiki" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="SELESAI &amp; DIPULIHKAN" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{Binding Resolved, StringFormat={}{0:N0}}" FontSize="32" FontWeight="Bold" Foreground="#16A34A" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding ResolvedRate}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Background="#FEF2F2" BorderBrush="#FCA5A5">
                    <StackPanel>
                        <TextBlock Text="VERIFIKASI MENDESAK" Style="{StaticResource EyebrowText}" Foreground="#991B1B"/>
                        <TextBlock Text="{Binding UrgentCount}" FontSize="32" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding UrgentNote}" FontSize="11.5" Foreground="#B91C1C"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Trend + categories -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Tren Pelaporan &amp; Penyelesaian" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Volume hambatan dilaporkan vs fasilitas diperbaiki (6 bulan terakhir)"
                                   Style="{StaticResource CardSub}" Margin="0,3,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                            <Ellipse Width="9" Height="9" Fill="#0F2A43" VerticalAlignment="Center"/>
                            <TextBlock Text="Masuk" FontSize="12" Margin="5,0,16,0" Foreground="{StaticResource Muted}"/>
                            <Ellipse Width="9" Height="9" Fill="#0E7490" VerticalAlignment="Center"/>
                            <TextBlock Text="Selesai" FontSize="12" Margin="5,0,0,0" Foreground="{StaticResource Muted}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Trend}" Height="200">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Incoming}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                                <Border Width="18" Height="{Binding IncomingHeight}" MinHeight="3" Background="#0F2A43" CornerRadius="4,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Done}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                                <Border Width="18" Height="{Binding ResolvedHeight}" MinHeight="3" Background="#0E7490" CornerRadius="4,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Month}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#F1F5F9" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155">
                                <Run Text="Efisiensi Penutupan: "/><Run Text="{Binding ClosingEfficiency, Mode=OneWay}"/><Run Text=" pada periode terpilih"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sebaran Kategori Hambatan" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Klasifikasi infrastruktur yang paling banyak dilaporkan warga pada periode terpilih"
                                   Style="{StaticResource CardSub}" Margin="0,3,0,16"/>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#334155" HorizontalAlignment="Left"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource Muted}">
                                                <Run Text="{Binding Percent, Mode=OneWay}"/><Run Text="% ("/><Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" lap.)"/>
                                            </TextBlock>
                                        </Grid>
                                        <Border Height="8" Background="#E2E8F0" CornerRadius="4" HorizontalAlignment="Stretch">
                                            <Border Height="8" Width="{Binding BarWidth}" MaxWidth="260" CornerRadius="4" HorizontalAlignment="Left"
                                                    Background="{Binding Color}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Priority queue + activity log -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Antrean Prioritas Kritis Siap Verifikasi" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="Laporan bahaya fatal bagi pengguna kursi roda &amp; tunanetra yang membutuhkan disposisi instan"
                                           Style="{StaticResource CardSub}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Background="#FEF2F2" CornerRadius="8" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#B91C1C">
                                    <Run Text="{Binding UrgentCount, Mode=OneWay}"/><Run Text=" Butuh Aksi Segera"/>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PriorityQueue}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="{Binding Reporter}" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <Run Text="📍 "/><Run Text="{Binding Location, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Time, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Verifikasi" Padding="12,6" VerticalAlignment="Center" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                    CommandParameter="{Binding Id}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource GhostButton}" Content="Buka Seluruh Antrean →" Command="{Binding OpenQueueCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Log Aktivitas Terakhir" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Pembaruan status operasional lintas verifikator &amp; dinas"
                                   Style="{StaticResource CardSub}" Margin="0,3,0,14"/>
                        <ItemsControl ItemsSource="{Binding ActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource Teal}" VerticalAlignment="Top" Margin="0,4,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,0,70,0"/>
                                                <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
