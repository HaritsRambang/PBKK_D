<UserControl x:Class="AksesKita.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0F2A43">
        <Border Style="{StaticResource Card}" Width="440" Padding="36"
                VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource Teal}">
                        <TextBlock Text="&#9855;" FontSize="26" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AksesKita" FontWeight="Bold" FontSize="22" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Ruang Inklusif" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Masuk untuk melanjutkan" FontSize="14" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,8,0,24"/>

                <TextBlock Text="Nama Anda" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource FormInput}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Pilih peran untuk mencoba alur masing-masing pengguna."
                           FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap"/>

                <Button Style="{StaticResource PrimaryButton}" Content="Masuk sebagai Warga Pelapor"
                        Command="{Binding MasukWargaCommand}" HorizontalContentAlignment="Center"/>
                <Button Style="{StaticResource GhostButton}" Content="Masuk sebagai Admin / Petugas"
                        Command="{Binding MasukAdminCommand}" Margin="0,10,0,0" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
