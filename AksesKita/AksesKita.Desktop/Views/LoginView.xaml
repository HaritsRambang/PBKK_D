<UserControl x:Class="AksesKita.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource LoginBg}">
        <Grid.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SubmitCommand}"/>
        </Grid.InputBindings>

        <!-- Theme toggle (same command as the top bar inside the app) -->
        <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,20,24,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Content="{Binding DataContext.ThemeLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                Command="{Binding DataContext.ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

        <Border Style="{StaticResource Card}" Width="460" Padding="36"
                VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="48" Height="48" CornerRadius="13" Background="{DynamicResource Teal}">
                        <TextBlock Text="&#9855;" FontSize="26" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AksesKita" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="Ruang Inklusif · Kota Surabaya" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                           HorizontalAlignment="Center" Margin="0,10,0,20"/>

                <!-- Name (register only) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nama Lengkap" FontWeight="SemiBold" Foreground="{DynamicResource Body}" Margin="0,0,0,5"/>
                    <TextBox Style="{StaticResource FormInput}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                </StackPanel>

                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{DynamicResource Body}" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource FormInput}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Kata Sandi" FontWeight="SemiBold" Foreground="{DynamicResource Body}" Margin="0,12,0,5"/>
                <PasswordBox x:Name="PwdBox" Style="{StaticResource FormPassword}"/>

                <!-- Confirm password (register only) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Konfirmasi Kata Sandi" FontWeight="SemiBold" Foreground="{DynamicResource Body}" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource FormPassword}"/>
                    <TextBlock Text="Minimal 8 karakter, kombinasi huruf dan angka. Akun baru terdaftar sebagai Warga Pelapor."
                               FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0"/>

                <Button Style="{StaticResource PrimaryButton}" Content="{Binding SubmitLabel}"
                        Command="{Binding SubmitCommand}" Margin="0,14,0,0"/>
                <Button Style="{StaticResource LinkButton}" Content="{Binding ToggleLabel}"
                        Command="{Binding ToggleModeCommand}" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
