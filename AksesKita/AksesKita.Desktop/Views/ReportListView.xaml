<UserControl x:Class="AksesKita.Desktop.Views.ReportListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Daftar &amp; Manajemen Laporan" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="Pusat kendali verifikasi, eskalasi, dan audit perbaikan hambatan mobilitas di Kota Surabaya."
                           Style="{StaticResource CardSub}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="➕  Laporan Baru" Command="{Binding NewReportCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <WrapPanel VerticalAlignment="Center">
                <Grid Width="300" Margin="0,0,14,0">
                    <TextBox x:Name="ListSearch" Style="{StaticResource FormInput}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,11,8"/>
                    <TextBlock Text="🔍" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Cari judul, lokasi, atau ID tiket..." Margin="34,0,0,0" VerticalAlignment="Center"
                               Foreground="#94A3B8" FontSize="13" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ListSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Text="Status" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="150" Padding="8,6" Margin="0,0,14,0"/>

                <TextBlock Text="Tingkat" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}" Width="110" Padding="8,6" Margin="0,0,14,0"/>

                <CheckBox Content="Hanya laporan saya" IsChecked="{Binding OnlyMine}" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#334155"/>
                <Button Style="{StaticResource GhostButton}" Content="Reset" Padding="14,6" Command="{Binding ResetFilterCommand}"/>
            </WrapPanel>
        </Border>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Muted}" Margin="12,10,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Reports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TicketCode}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="{Binding Category.Name}" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run Text="📍 "/><Run Text="{Binding Address, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="👍" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SupportCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="3" CornerRadius="8" Padding="11,6" VerticalAlignment="Center" Margin="0,0,8,0"
                                                Background="{Binding Status, Converter={StaticResource StatusToTint}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumLabel}}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                        </Border>

                                        <Border Grid.Column="4" CornerRadius="8" Padding="11,6" VerticalAlignment="Center" Margin="0,0,12,0"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToTint}}">
                                            <TextBlock Text="{Binding Severity}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        </Border>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Content="Detail" Padding="14,7"
                                                    Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Hapus" Padding="14,7" Margin="8,0,0,0" Foreground="#DC2626"
                                                    Command="{Binding DataContext.DeleteReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
