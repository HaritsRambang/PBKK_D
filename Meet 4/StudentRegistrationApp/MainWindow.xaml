<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#26364A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="STUDENT REGISTRATION" FontSize="28" FontWeight="Bold" Foreground="#1D4ED8"/>
            <TextBlock Text="Kelola data mahasiswa dengan mudah" FontSize="14" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="FORM MAHASISWA" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="NIM" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtNim"/>

                    <TextBlock Text="Nama Mahasiswa" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtNama"/>

                    <TextBlock Text="Program Studi" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbProdi" SelectedIndex="-1">
                        <ComboBoxItem Content="Teknik Informatika"/>
                        <ComboBoxItem Content="Sistem Informasi"/>
                        <ComboBoxItem Content="Manajemen"/>
                        <ComboBoxItem Content="Akuntansi"/>
                    </ComboBox>

                    <TextBlock Text="Jenis Kelamin" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,24">
                        <RadioButton x:Name="rbLaki" Content="Laki-laki" Margin="0,0,24,0"/>
                        <RadioButton x:Name="rbPerempuan" Content="Perempuan"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Simpan" Click="BtnSimpan_Click" Background="#2563EB" Foreground="White"/>
                        <Button Content="Reset" Click="BtnReset_Click" Background="#E2E8F0" Foreground="#26364A"/>
                    </StackPanel>
                    <Button Content="Hapus Data Terpilih" Click="BtnHapus_Click" Background="#FEE2E2" Foreground="#B91C1C" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="DATA MAHASISWA" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="txtCounter" Text="0 mahasiswa" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ListBox x:Name="lstMahasiswa" Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" DisplayMemberPath="DisplayText"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
