<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration Manager" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24324A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E4D8F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E4D8F" CornerRadius="10" Padding="22" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="STUDENT REGISTRATION MANAGER" FontSize="25" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Meet 5 | Kelola data mahasiswa dengan cepat dan teratur" Foreground="#DDEBFF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                        <TextBlock Text="FORM MAHASISWA" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBlock Text="NIM" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Nim, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Nama Mahasiswa" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Program Studi" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding Prodi, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Jenis Kelamin" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Simpan" Command="{Binding SaveCommand}" Background="#2563EB" Foreground="White"/>
                            <Button Content="Update" Command="{Binding UpdateCommand}" Background="#0F766E" Foreground="White"/>
                            <Button Content="Reset" Command="{Binding ResetCommand}" Background="#E2E8F0" Foreground="#24324A" Margin="0"/>
                        </StackPanel>
                        <Button Content="Hapus Data Terpilih" Command="{Binding DeleteCommand}" Background="#FEE2E2" Foreground="#B91C1C" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="DATA MAHASISWA" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="34" Margin="10,0,0,0" Padding="10,6" ToolTip="Cari NIM, nama, atau program studi"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding VisibleStudents}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#CBD5E1" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="110"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="150"/>
                            <DataGridTextColumn Header="Prodi" Binding="{Binding Prodi}" Width="140"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding CounterText}" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
