<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration Manager - SQL Server" Height="640" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24324A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E4D8F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E4D8F" CornerRadius="10" Padding="22" Margin="0,0,0,20">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="STUDENT REGISTRATION MANAGER" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Meet 6 | Integrasi SQL Server dengan WPF dan ADO.NET" Foreground="#DDEBFF" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh Data"
                        Click="RefreshButton_Click"
                        Background="#FFFFFF"
                        Foreground="#1E4D8F"
                        VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="DAFTAR MAHASISWA (SQL SERVER)" FontSize="17" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Status: Siap" Foreground="#0F766E" FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid x:Name="StudentsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          RowHeight="34"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="115"/>
                        <DataGridTextColumn Header="Nama Mahasiswa" Binding="{Binding Nama}" Width="180"/>
                        <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramName}" Width="210"/>
                        <DataGridTextColumn Header="Tanggal Lahir" Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}" Width="115"/>
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="*"/>
                        <DataGridTextColumn Header="No. Telepon" Binding="{Binding NoTelepon}" Width="120"/>
                        <DataGridTextColumn Header="Dibuat" Binding="{Binding Dibuat, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TotalStudentsText"
                           Grid.Row="2"
                           Text="Total Mahasiswa: 0"
                           Foreground="#1D4ED8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,14,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
